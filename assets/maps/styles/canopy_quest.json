{
  "version": 8,
  "name": "Trailseek Canopy Quest",
  "metadata": {
    "trailseek:purpose": "Explore screen game theme proof of concept",
    "trailseek:description": "Mossy jungle canopy, deep woodland and amber expedition paths",
    "trailseek:themeVersion": 1
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet/latest",
      "attribution": "OpenFreeMap © OpenMapTiles Data from OpenStreetMap"
    }
  },
  "layers": [
    {
      "id": "ground",
      "type": "background",
      "paint": {
        "background-color": "#DDE7BC"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "wood",
            "forest"
          ],
          "#32644D",
          [
            "grass",
            "scrub"
          ],
          "#6C9C67",
          [
            "farmland",
            "crop"
          ],
          "#A9B780",
          "#6C9C67"
        ],
        "fill-opacity": 0.88
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "class"
          ],
          [
            "park",
            "national_park",
            "nature_reserve"
          ],
          "#4F8E5F",
          [
            "forest",
            "wood"
          ],
          "#32644D",
          [
            "farmland",
            "orchard",
            "vineyard"
          ],
          "#A9B780",
          "#DDE7BC"
        ],
        "fill-opacity": 0.62
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#5F9D9F"
      }
    },
    {
      "id": "river",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#337D87",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.7,
          13,
          2.4
        ]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "minzoom": 6,
      "paint": {
        "line-color": "#718F64",
        "line-width": 0.8,
        "line-dasharray": [
          3,
          2
        ],
        "line-opacity": 0.7
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#A3AD86",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "major-road-outline",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary"
          ]
        ]
      ],
      "paint": {
        "line-color": "#453D32",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          2,
          14,
          7.5
        ]
      }
    },
    {
      "id": "major-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary",
            "secondary"
          ]
        ]
      ],
      "paint": {
        "line-color": "#F0E9B9",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          1.1,
          14,
          5
        ]
      }
    },
    {
      "id": "minor-roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "tertiary",
            "residential",
            "service",
            "living_street",
            "unclassified"
          ]
        ]
      ],
      "paint": {
        "line-color": "#91A06D",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.7,
          15,
          2.6
        ]
      }
    },
    {
      "id": "adventure-trails",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 11,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "path",
            "footway",
            "track",
            "steps",
            "pedestrian",
            "bridleway"
          ]
        ]
      ],
      "paint": {
        "line-color": "#E1A64F",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          0.9,
          15,
          2.4
        ],
        "line-dasharray": [
          2,
          1.7
        ]
      }
    },
    {
      "id": "place-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 5,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          5,
          10,
          14,
          15
        ],
        "text-max-width": 11,
        "text-font": [
          "Noto Sans Regular"
        ]
      },
      "paint": {
        "text-color": "#233F2D",
        "text-halo-color": "#E9EDC7",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "water-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 10,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": 11,
        "text-max-width": 11,
        "text-font": [
          "Noto Sans Regular"
        ]
      },
      "paint": {
        "text-color": "#233F2D",
        "text-halo-color": "#E9EDC7",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "road-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": 10,
        "text-max-width": 11,
        "text-font": [
          "Noto Sans Regular"
        ]
      },
      "paint": {
        "text-color": "#233F2D",
        "text-halo-color": "#E9EDC7",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "poi-names",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:latin"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-size": 10,
        "text-max-width": 11,
        "text-font": [
          "Noto Sans Regular"
        ]
      },
      "paint": {
        "text-color": "#233F2D",
        "text-halo-color": "#E9EDC7",
        "text-halo-width": 1.4
      }
    }
  ]
}
